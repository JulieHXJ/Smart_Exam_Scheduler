# Local development only. Copy to backend/.env and load as environment variables.
ALLOWED_ADMIN_EMAIL=your.staff@tha.de
ALLOWED_TEST_EMAIL=your.test@tha.de
AUTH_SECRET=replace_with_at_least_32_cryptographically_random_characters
AUTH_SECURE_COOKIE=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Smart Exam <login@localhost>"
SMTP_STARTTLS=false
# Production: AUTH_SECURE_COOKIE=true, HTTPS, shared persistent OTP/session storage.
